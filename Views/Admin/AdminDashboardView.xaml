<UserControl x:Class="CAKA.PerformanceApp.Views.Admin.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600">
    <UserControl.Resources>
        <!-- Sabit satır yükseklikleri: isim sarılsa bile çubuklar hizalı kalır -->
        <DataTemplate x:Key="DashboardBarColumnTemplate">
            <Grid Margin="0,0,20,0" Width="110" MinWidth="110" Height="210">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Value, StringFormat='{}{0:N1} sa'}"
                           Style="{StaticResource SubtitleTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"/>
                <Grid Grid.Row="1" Margin="0,4,0,4">
                    <Border VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Width="32"
                            CornerRadius="4"
                            Height="{Binding Value, Converter={StaticResource ChartBarHeightConverter}}"
                            Background="{StaticResource AccentBrush}"
                            Opacity="0.85"/>
                </Grid>
                <TextBlock Grid.Row="2"
                           Text="{Binding Label}"
                           Style="{StaticResource SubtitleTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxHeight="56"
                           LineHeight="14"
                           FontSize="12"
                           ToolTip="{Binding Label}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Toplam Çalışan" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,8"/>
                    <TextBlock FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                               Text="{Binding TotalEmployees}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding PeriodTotalHoursLabel}" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,8"/>
                    <TextBlock FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               Text="{Binding PeriodTotalHours, StringFormat={}{0:N1}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Personel grafiği -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="{Binding PersonnelChartTitle}" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Başlangıç" VerticalAlignment="Center" Margin="0,0,8,0"
                               Style="{StaticResource SubtitleTextStyle}"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding PersonnelFilterFrom, UpdateSourceTrigger=PropertyChanged}"
                                Width="130" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="2" Text="Bitiş" VerticalAlignment="Center" Margin="0,0,8,0"
                               Style="{StaticResource SubtitleTextStyle}"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <DatePicker SelectedDate="{Binding PersonnelFilterTo, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130" Margin="0,0,8,0"/>
                        <Button Content="Uygula" Command="{Binding ApplyPersonnelFilterCommand}"
                                Padding="14,6" Margin="0,0,8,0"
                                Background="{StaticResource AccentBrush}" Foreground="White"/>
                        <Button Content="Bu hafta" Command="{Binding ResetPersonnelFilterCommand}"
                                Padding="14,6" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ChartData}"
                                  ItemTemplate="{StaticResource DashboardBarColumnTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- İş bazlı grafik -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="{Binding JobChartTitle}" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Başlangıç" VerticalAlignment="Center" Margin="0,0,8,0"
                               Style="{StaticResource SubtitleTextStyle}"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding JobFilterFrom, UpdateSourceTrigger=PropertyChanged}"
                                Width="130" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="2" Text="Bitiş" VerticalAlignment="Center" Margin="0,0,8,0"
                               Style="{StaticResource SubtitleTextStyle}"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <DatePicker SelectedDate="{Binding JobFilterTo, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130" Margin="0,0,8,0"/>
                        <Button Content="Uygula" Command="{Binding ApplyJobFilterCommand}"
                                Padding="14,6" Margin="0,0,8,0"
                                Background="{StaticResource AccentBrush}" Foreground="White"/>
                        <Button Content="Bu ay" Command="{Binding ResetJobFilterCommand}"
                                Padding="14,6" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding JobChartData}"
                                  ItemTemplate="{StaticResource DashboardBarColumnTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="Varsayılan: içinde bulunulan ay. Tarih aralığını değiştirip Uygula ile iş bazında toplam saatleri görüntüleyin."
                           Style="{StaticResource SubtitleTextStyle}" Margin="0,12,0,0" FontSize="11" Opacity="0.85"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Son aktiviteler" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420" Padding="0,0,16,0">
                    <ItemsControl ItemsSource="{Binding RecentActivities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Time, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
