<UserControl x:Class="CAKA.PerformanceApp.Views.Admin.AdminJobsView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="880">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Yeni iş ekle" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>
                    <TextBlock Text="Bu sayfada yalnızca yeni iş tanımı eklenir. Güncelleme/silme/aktif-pasif işlemleri için menüdeki İş Yönetimi sayfasını kullanın." Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="140"/>
                            <ColumnDefinition Width="*" MinWidth="160"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="İş kodu" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewCode, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"
                                     ToolTip="Örn. TRCK-0064"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0">
                            <TextBlock Text="Açıklama" Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"
                                     ToolTip="Örn. DemirExport"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Content="İş ekle" Command="{Binding AddJobCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="20,10" Margin="0,0,8,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Aşamalar (sıra: Stage 1, 2, 3…; bir satır silinince numaralar otomatik kayar)" Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,6"/>
                    <ItemsControl ItemsSource="{Binding EditStages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Padding="8,8,8,6" VerticalAlignment="Center"
                                               Text="{Binding ResolvedName}" FontWeight="SemiBold"
                                               ToolTip="Listedeki sıra; silinen aşamadan sonrakiler bir numara yukarı kayar."/>
                                    <TextBox Grid.Column="1" Margin="8,0" Padding="8,6" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Aşama açıklaması (isteğe bağlı)"/>
                                    <Button Grid.Column="2" Content="Sil" Padding="12,6"
                                            Command="{Binding DataContext.RemoveStageCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Aşama ekle" Command="{Binding AddStageCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Padding="12,8" Background="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="Bu işe atanmış çalışanlar ve işe özel saatlik ücret" Style="{StaticResource SubtitleTextStyle}" Margin="0,16,0,6"/>
                    <ItemsControl ItemsSource="{Binding EditParticipants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Padding="8,6"
                                              ItemsSource="{Binding DataContext.UserOptions, ElementName=Root}"
                                              SelectedValue="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="UserName"
                                              DisplayMemberPath="DisplayName"/>
                                    <TextBox Grid.Column="1" Margin="8,0" Padding="8,6" Text="{Binding HourlyRate, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Saatlik tutar"/>
                                    <ComboBox Grid.Column="2" Margin="8,0" Padding="8,6"
                                              ItemsSource="{Binding DataContext.CurrencyOptions, ElementName=Root}"
                                              SelectedValue="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Code"
                                              DisplayMemberPath="Label"
                                              ToolTip="Ücret birimi"/>
                                    <Button Grid.Column="3" Content="Sil" Padding="12,6"
                                            Command="{Binding DataContext.RemoveParticipantCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Çalışan satırı ekle" Command="{Binding AddParticipantCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Padding="12,8" Background="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="Plan: hangi çalışan hangi aşamada kaç saat" Style="{StaticResource SubtitleTextStyle}" Margin="0,16,0,6"/>
                    <ItemsControl ItemsSource="{Binding EditPlans}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Padding="8,6"
                                              ItemsSource="{Binding DataContext.StagePickList, ElementName=Root}"
                                              SelectedValue="{Binding StagePickerValue, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Index"
                                              DisplayMemberPath="Label"/>
                                    <ComboBox Grid.Column="1" Margin="8,0" Padding="8,6"
                                              ItemsSource="{Binding DataContext.PlanParticipantPickList, ElementName=Root}"
                                              SelectedValue="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="UserName"
                                              DisplayMemberPath="DisplayName"
                                              ToolTip="Önce işe çalışan ekleyin; planda yalnızca onlar seçilir."/>
                                    <TextBox Grid.Column="2" Margin="8,0" Padding="8,6" Text="{Binding PlannedHours, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="3" Content="Sil" Padding="12,6"
                                            Command="{Binding DataContext.RemovePlanCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Plan satırı ekle" Command="{Binding AddPlanCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Padding="12,8" Background="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
