<UserControl x:Class="CAKA.PerformanceApp.Views.Personel.PersonelAddWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="İş Kaydı Gir" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="Günlük çalışma saatlerinizi iş veya ofis dışı gezi olarak kaydedin."
                               Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Satır ekle" Command="{Binding AddRowCommand}"
                        Style="{StaticResource DashboardFilterApplyButtonStyle}"
                        VerticalAlignment="Center" MinWidth="120"/>
            </Grid>
        </Border>

        <!-- Tarih — koyu filtre şeridi -->
        <Border Grid.Row="1" Style="{StaticResource DashboardFilterPanelStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kayıt tarihi" Style="{StaticResource DashboardFilterTitleStyle}"/>
                    <TextBlock Text="{Binding AllowedPeriodHint}" Style="{StaticResource DashboardFilterHintStyle}"
                               Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="720"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" MinWidth="200">
                    <TextBlock Text="TARİH (TÜM SATIRLAR)" Style="{StaticResource DashboardFilterLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}"
                                DisplayDateStart="{Binding EntryMinDate, Mode=OneWay}"
                                DisplayDateEnd="{Binding EntryMaxDate, Mode=OneWay}"
                                Style="{StaticResource DashboardFilterDatePickerStyle}"
                                Width="160"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tablo -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Background="#F8FAFC" Padding="20,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SubtitleTextStyle}" FontSize="13">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">İpucu:</Run>
                        <Run> Aktif işlerden birini veya her zaman listede bulunan </Run>
                        <Run FontWeight="SemiBold">Ofis Dışı Gezi</Run>
                        <Run> seçeneğini kullanın. Aşamalı işlerde aşama zorunludur.</Run>
                    </TextBlock>
                </Border>
                <DataGrid ItemsSource="{Binding Entries}"
                          Style="{StaticResource PersonelWorkDataGridStyle}"
                          Margin="0"
                          MinHeight="220">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="İş / Tür" Width="2*" MinWidth="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Jobs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding SelectedJob, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="DisplayText"
                                              Padding="10,8" Margin="8,4" FontSize="13"
                                              BorderBrush="{StaticResource BorderBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Aşama" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding StageOptions}"
                                              SelectedValue="{Binding SelectedStageId, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="StageId"
                                              DisplayMemberPath="Label"
                                              IsEnabled="{Binding HasStageChoices}"
                                              Padding="10,8" Margin="8,4" FontSize="13"
                                              BorderBrush="{StaticResource BorderBrush}"
                                              ToolTip="Ofis Dışı Gezi veya aşamasız işlerde kullanılmaz."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Saat" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Hours, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalToStringConverter}, Mode=TwoWay}"
                                             Padding="10,8" Margin="8,4" FontSize="13"
                                             VerticalContentAlignment="Center"
                                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Sil" Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="8,4" Padding="12,6" FontSize="12"
                                            Background="#C62828" Foreground="White" BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Alt aksiyon -->
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" FontSize="13" TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <Button Grid.Column="1" Content="Tümünü kaydet" Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="36,14" FontSize="14" MinWidth="180"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
