<UserControl x:Class="CAKA.PerformanceApp.Views.Personel.PersonelAddWorkView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="İş Kaydı Gir" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="Haftalık çalışma saatlerinizi tek tabloda girin. Her gün için hedef 8 saattir (hafta içi)."
                               Style="{StaticResource SubtitleTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Satır ekle" Command="{Binding AddRowCommand}"
                        Style="{StaticResource DashboardFilterApplyButtonStyle}"
                        VerticalAlignment="Center" MinWidth="120"/>
            </Grid>
        </Border>

        <!-- Hafta seçimi -->
        <Border Grid.Row="1" Style="{StaticResource DashboardFilterPanelStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Çalışma haftası" Style="{StaticResource DashboardFilterTitleStyle}"/>
                    <TextBlock Text="{Binding AllowedPeriodHint}" Style="{StaticResource DashboardFilterHintStyle}"
                               Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="720"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" MinWidth="240">
                    <TextBlock Text="HAFTA" Style="{StaticResource DashboardFilterLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding AvailableWeeks}"
                              SelectedValue="{Binding SelectedWeekStart, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="WeekStart"
                              DisplayMemberPath="Label"
                              Padding="10,8" FontSize="13" MinWidth="220"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hedef + tarih şeridi -->
        <StackPanel Grid.Row="2">
            <Border Background="#E8F4FD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0" Padding="0">
                <Grid Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="180"/>
                        <ColumnDefinition Width="180" MinWidth="140"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="56"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Hedef (günlük)" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="14,0,8,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding TargetWeekTotal}" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding TargetWeekdayHours}" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding TargetWeekdayHours}" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="{Binding TargetWeekdayHours}" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="{Binding TargetWeekdayHours}" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="{Binding TargetWeekdayHours}" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="8" Text="{Binding TargetWeekendHours}" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="9" Text="{Binding TargetWeekendHours}" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,0" Padding="0">
                <Grid Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="180"/>
                        <ColumnDefinition Width="180" MinWidth="140"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="56"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="3" Text="{Binding Day1Date}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding Day2Date}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="{Binding Day3Date}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="{Binding Day4Date}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="{Binding Day5Date}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="8" Text="{Binding Day6Date}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="9" Text="{Binding Day7Date}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Haftalık tablo -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" BorderThickness="1,0,1,1">
            <DataGrid ItemsSource="{Binding Entries}"
                      Style="{StaticResource PersonelWorkDataGridStyle}"
                      Margin="0" MinHeight="260"
                      IsReadOnly="{Binding IsWeekEditable, Converter={StaticResource InverseBooleanConverter}}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="İş / Tür" Width="220" MinWidth="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Jobs, ElementName=Root}"
                                          SelectedItem="{Binding SelectedJob, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="DisplayText"
                                          Padding="8,6" Margin="6,4" FontSize="12"
                                          IsEnabled="{Binding DataContext.IsWeekEditable, ElementName=Root}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Aşama" Width="180" MinWidth="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding StageOptions}"
                                          SelectedValue="{Binding SelectedStageId, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="StageId"
                                          DisplayMemberPath="Label"
                                          IsEnabled="{Binding HasStageChoices}"
                                          Padding="8,6" Margin="6,4" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Toplam" Binding="{Binding RowTotal, StringFormat={}{0:0.#}}"
                                        Width="72" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Pzt" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HoursMonday, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalToStringConverter}, Mode=TwoWay}"
                                         Padding="6,6" Margin="4,4" FontSize="12" HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Sal" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HoursTuesday, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalToStringConverter}, Mode=TwoWay}"
                                         Padding="6,6" Margin="4,4" FontSize="12" HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Çar" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HoursWednesday, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalToStringConverter}, Mode=TwoWay}"
                                         Padding="6,6" Margin="4,4" FontSize="12" HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Per" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HoursThursday, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalToStringConverter}, Mode=TwoWay}"
                                         Padding="6,6" Margin="4,4" FontSize="12" HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Cum" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HoursFriday, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalToStringConverter}, Mode=TwoWay}"
                                         Padding="6,6" Margin="4,4" FontSize="12" HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Cmt" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HoursSaturday, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalToStringConverter}, Mode=TwoWay}"
                                         Padding="6,6" Margin="4,4" FontSize="12" HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Paz" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HoursSunday, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalToStringConverter}, Mode=TwoWay}"
                                         Padding="6,6" Margin="4,4" FontSize="12" HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Sil" Command="{Binding DataContext.RemoveRowCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Margin="4,4" Padding="10,5" FontSize="11"
                                        Background="#C62828" Foreground="White" BorderThickness="0"
                                        Visibility="{Binding DataContext.IsWeekEditable, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Günlük toplamlar -->
        <Border Grid.Row="4" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1"
                Padding="0" Margin="0,0,0,12">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="180"/>
                    <ColumnDefinition Width="180" MinWidth="140"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Girilen toplam" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding TotalAll, StringFormat={}{0:0.#}}" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding TotalMonday, StringFormat={}{0:0.#}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding TotalTuesday, StringFormat={}{0:0.#}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding TotalWednesday, StringFormat={}{0:0.#}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="{Binding TotalThursday, StringFormat={}{0:0.#}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="7" Text="{Binding TotalFriday, StringFormat={}{0:0.#}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="8" Text="{Binding TotalSaturday, StringFormat={}{0:0.#}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="9" Text="{Binding TotalSunday, StringFormat={}{0:0.#}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Kaydet -->
        <Border Grid.Row="5" Padding="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" FontSize="13" TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <Button Grid.Column="1" Content="Haftayı kaydet" Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="36,14" FontSize="14" MinWidth="180"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
